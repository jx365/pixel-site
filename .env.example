# Copy to .env before production deploy:  copy .env.example .env

# Required: change to a long random string
SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated browser origins (your site URL(s))
# Example LAN: http://192.168.1.100,http://huashiofftyl.local
CORS_ORIGINS=http://localhost,http://127.0.0.1

# SQLite path inside backend container (default is fine for small teams)
DATABASE_URL=sqlite:////app/data/pixel_art.db
